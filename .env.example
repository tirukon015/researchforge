# ============================================================
# ResearchForge — Example Environment File
# ============================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in REAL values inside .env  (never inside this file)
#   3. .env is git-ignored and must NEVER be committed
#
# This file is committed to GitHub on purpose. It documents
# WHICH variables the project needs, using placeholders only.
# Every value below is a fake placeholder.
# ============================================================


# ------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------
APP_NAME="ResearchForge"
# development | production
APP_ENV=development
# Set to false in production
DEBUG=true
# Port the FastAPI backend listens on locally
BACKEND_PORT=8000


# ------------------------------------------------------------
# 2. AI PROVIDER / GENERATION  (D5 still formally OPEN)
# ------------------------------------------------------------
# The backend talks to src/rag/llm/base.py::LLMProvider, never to a
# vendor SDK directly. LLM_PROVIDER selects the implementation, so
# switching vendors is a new file plus this one variable.
#
# Anthropic is implemented first. D5 remains open in CLAUDE.md §9:
# adding a second provider does not require changing any other code.
LLM_PROVIDER=anthropic

# --- Anthropic (implemented) ---
# Get a key at https://console.anthropic.com
# SECURITY: server-side only. Never commit it, never log it, and never
# place it behind a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY
LLM_MODEL=claude-opus-5

# How hard the model thinks: low | medium | high | xhigh | max
# "high" suits analytical work; "low" is enough for a smoke test.
LLM_EFFORT=high
LLM_MAX_OUTPUT_TOKENS=16000

# NOTE: there is deliberately no LLM_TEMPERATURE. Sampling parameters
# (temperature/top_p/top_k) were REMOVED on this model family and are
# rejected with a 400. Use LLM_EFFORT to control output instead.

# --- Not implemented (D5 alternatives) ---
# Adding one of these means adding src/rag/llm/<vendor>_provider.py
# and setting LLM_PROVIDER to its name.
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# GOOGLE_API_KEY=REPLACE_WITH_YOUR_KEY


# ------------------------------------------------------------
# 2a. LONG-PAPER HANDLING
# ------------------------------------------------------------
# claude-opus-5 has a 1,000,000-token context window, so an ordinary
# paper is analysed WHOLE - which is what lets the model connect a
# limitation in section 6 to a claim in section 3. Chunking activates
# only past this threshold, measured in characters (~4 chars/token).
LONG_PAPER_CHAR_THRESHOLD=400000
LONG_PAPER_CHUNK_SIZE=40000
LONG_PAPER_CHUNK_OVERLAP=2000


# 3. EMBEDDING MODEL  (FINAL — LOCKED, see PROJECT_PLAN.md §F decision 2)
# ------------------------------------------------------------
# The embedding model turns text into vectors for semantic search.
#
# Get a FREE API key at https://jina.ai/embeddings/
#   - 10 million free tokens. NO credit card required.
#   - Roughly 10x more than this project needs.
#
# SECURITY: this key is SERVER-SIDE ONLY. Never commit it, never log
# it, and never place it behind a NEXT_PUBLIC_ prefix.
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
JINA_API_KEY=REPLACE_WITH_YOUR_KEY

# !! DO NOT CHANGE 1024 WITHOUT RE-EMBEDDING EVERY PAPER !!
# Three things must agree, or inserts fail:
#   1. this value
#   2. the dimensions requested from the embedding API
#   3. the vector(1024) column in the database
#
# Why 1024? It is jina-embeddings-v3's default size AND it sits well
# under pgvector's 2000-dimension limit for HNSW/IVFFlat indexes.
EMBEDDING_DIMENSIONS=1024

# Asymmetric retrieval (jina-embeddings-v3 task adapters).
# Questions and documents are different kinds of text, so each is
# encoded with an adapter trained for its role. This measurably
# improves retrieval quality over embedding both identically.
EMBEDDING_TASK_DOCUMENT=retrieval.passage
EMBEDDING_TASK_QUERY=retrieval.query


# ------------------------------------------------------------
# 4. SUPABASE / POSTGRES DATABASE
# ------------------------------------------------------------
# Find these in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Safe for the browser (public, row-level-security enforced)
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY

# SECRET — backend only. Bypasses row-level security.
# NEVER expose this to the frontend or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# Direct Postgres connection (used for pgvector queries/migrations)
DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres


# ------------------------------------------------------------
# 5. FILE STORAGE
# ------------------------------------------------------------
# Supabase Storage bucket that holds uploaded PDFs
STORAGE_BUCKET=papers
# Reject uploads larger than this (megabytes)
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=application/pdf


# ------------------------------------------------------------
# 6. RAG / RETRIEVAL SETTINGS  (NOT YET IMPLEMENTED)
# ------------------------------------------------------------
# These belong to the future embedding/retrieval pipeline
# (Milestone 4). They are NOT the long-paper settings in §2a -
# the two chunkers are separate on purpose.
# Characters (or tokens) per chunk of a paper
CHUNK_SIZE=1000
# Overlap between chunks so sentences aren't cut mid-idea
CHUNK_OVERLAP=150
# How many chunks to retrieve per question
RETRIEVAL_TOP_K=8
# Minimum similarity score to accept a chunk (0.0 - 1.0)
RETRIEVAL_MIN_SCORE=0.3


# ------------------------------------------------------------
# 7. FRONTEND (Next.js)
# ------------------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is visible in the browser.
# NEVER put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY


# ------------------------------------------------------------
# 8. SECURITY
# ------------------------------------------------------------
# Comma-separated list of origins allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Requests per minute per client
RATE_LIMIT_PER_MINUTE=30
