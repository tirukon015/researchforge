# ============================================================
# ResearchForge — Example Environment File
# ============================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in REAL values inside .env  (never inside this file)
#   3. .env is git-ignored and must NEVER be committed
#
# This file is committed to GitHub on purpose. It documents
# WHICH variables the project needs, using placeholders only.
# Every value below is a fake placeholder.
# ============================================================


# ------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------
APP_NAME="ResearchForge"
# development | production
APP_ENV=development
# Set to false in production
DEBUG=true
# Port the FastAPI backend listens on locally
BACKEND_PORT=8000


# ------------------------------------------------------------
# 2. AI PROVIDER  (DECISION PENDING — see PROJECT_PLAN.md §F)
# ------------------------------------------------------------
# We have NOT committed to a provider yet. Uncomment ONE block
# after the decision is made. Keys shown are placeholders.
#
# LLM_PROVIDER controls which client the backend loads.
# Allowed values (planned): anthropic | openai | google | local
LLM_PROVIDER=CHANGE_ME

# --- Option A: Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
# LLM_MODEL=claude-sonnet-5

# --- Option B: OpenAI ---
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# LLM_MODEL=gpt-4o-mini

# --- Option C: Google Gemini ---
# GOOGLE_API_KEY=REPLACE_WITH_YOUR_KEY
# LLM_MODEL=gemini-2.0-flash

# Generation controls (provider-independent)
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096


# ------------------------------------------------------------
# 3. EMBEDDING MODEL  (LOCKED — see PROJECT_PLAN.md §F decision 2)
# ------------------------------------------------------------
# The embedding model turns text into vectors for semantic search.
#
# Get an API key at https://platform.openai.com/api-keys
#   - This is the OpenAI *developer platform*, NOT ChatGPT.
#     A ChatGPT Plus subscription does NOT provide API access.
#   - Requires a small prepaid balance (usually $5 minimum).
#   - Expected total spend for this project: well under $1.
#   - Set a hard spending limit in the dashboard as a backstop.
#
# SECURITY: this key is SERVER-SIDE ONLY. It must never be committed,
# never logged, and never placed behind a NEXT_PUBLIC_ prefix.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY

# !! DO NOT CHANGE 1536 WITHOUT RE-EMBEDDING EVERY PAPER !!
# Three things must agree, or inserts fail:
#   1. this value
#   2. the dimensions returned by the embedding model
#   3. the vector(1536) column in the database
#
# Why 1536? It is this model's native size AND it sits under pgvector's
# 2000-dimension limit for HNSW/IVFFlat indexes. (text-embedding-3-large
# returns 3072, which CANNOT be indexed — that is why we rejected it.)
EMBEDDING_DIMENSIONS=1536


# ------------------------------------------------------------
# 4. SUPABASE / POSTGRES DATABASE
# ------------------------------------------------------------
# Find these in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Safe for the browser (public, row-level-security enforced)
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY

# SECRET — backend only. Bypasses row-level security.
# NEVER expose this to the frontend or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# Direct Postgres connection (used for pgvector queries/migrations)
DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres


# ------------------------------------------------------------
# 5. FILE STORAGE
# ------------------------------------------------------------
# Supabase Storage bucket that holds uploaded PDFs
STORAGE_BUCKET=papers
# Reject uploads larger than this (megabytes)
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=application/pdf


# ------------------------------------------------------------
# 6. RAG / RETRIEVAL SETTINGS
# ------------------------------------------------------------
# Characters (or tokens) per chunk of a paper
CHUNK_SIZE=1000
# Overlap between chunks so sentences aren't cut mid-idea
CHUNK_OVERLAP=150
# How many chunks to retrieve per question
RETRIEVAL_TOP_K=8
# Minimum similarity score to accept a chunk (0.0 - 1.0)
RETRIEVAL_MIN_SCORE=0.3


# ------------------------------------------------------------
# 7. FRONTEND (Next.js)
# ------------------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is visible in the browser.
# NEVER put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY


# ------------------------------------------------------------
# 8. SECURITY
# ------------------------------------------------------------
# Comma-separated list of origins allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Requests per minute per client
RATE_LIMIT_PER_MINUTE=30
