# ============================================================
# ResearchForge — Frontend Environment Example
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in real values inside .env.local
#   3. .env.local is git-ignored and must NEVER be committed
#
# This file is committed on purpose: it documents WHICH variables
# the frontend needs. Placeholders only — never a real value.
#
# ⚠️  Anything prefixed NEXT_PUBLIC_ is embedded into the JavaScript
#     bundle and is VISIBLE TO THE WHOLE INTERNET.
#     NEVER put a secret behind NEXT_PUBLIC_.
#     The Supabase service-role key must NEVER appear in this file.
# ============================================================

# Base URL of the FastAPI backend.
#
# LOCAL DEVELOPMENT: Next runs on :3000 and uvicorn on :8000, so the two
# really are separate origins and the frontend needs the absolute URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# PRODUCTION: LEAVE THIS UNSET IN VERCEL.
# vercel.json rewrites /health and /api/* to the FastAPI service, so the API
# lives on the SAME ORIGIN as the page and src/lib/api.ts falls back to a
# relative path. Setting it to one absolute host makes every other host - the
# custom domain, every preview URL - a cross-origin caller that FastAPI's CORS
# allowlist will block, which shows up in the UI as "Backend offline".
