# ============================================================
# AI Research Paper Assistant: .gitignore
# Rule of thumb: never commit secrets, dependencies, build
# output, uploaded papers, or generated model artifacts.
# ============================================================

# ---------- Secrets & environment ----------
# NEVER commit real credentials. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
service-account*.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root: these are Python build artefacts produced at
# the top level. Unanchored `lib/` also matched app/src/lib/, silently
# excluding the frontend's API client from Git - a fresh clone then
# failed to build with 'Module not found: @/lib/api'.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (these are machine-specific, never commit)
venv/
.venv/
env/
ENV/
.python-version

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------- Project data ----------
# Uploaded and intermediate research papers are NOT committed:
# they can be copyrighted, large, and are user data.
data/raw/*
data/processed/*
!data/**/.gitkeep
!data/samples/            # small, openly-licensed samples MAY be committed
*.pdf
!data/samples/*.pdf

# ---------- Models & large artifacts ----------
# Local model weights / caches are far too large for Git.
models/*
!models/.gitkeep
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.safetensors
.cache/
.huggingface/

# ---------- Generated results ----------
# Evaluation runs are regenerated by scripts; only curated,
# committed-on-purpose reports belong in Git.
results/*
!results/.gitkeep
!results/**/*.md
# Evaluation evidence IS tracked. CLAUDE.md section 10 lists results/ as in
# Git, and the report and evidence pack cite these files as the audit trail,
# so an examiner must be able to open them. 301 KB in total.
!results/evaluation/

# ---------- Databases & logs ----------
*.sqlite
*.sqlite3
*.db
*.log
logs/

# ---------- OS / Editor ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.claude/settings.local.json
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~

# ---------- Misc ----------
tmp/
temp/
scratch/

# Office lock files, created while a document is open
~$*
